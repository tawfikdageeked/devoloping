		eshell-mode-hook))
  (add-hook mode (lambda () (dislplay-line-numbers-mode 0))))




;; Initialize package sources
(require 'package)

(setq package-archives '(("melpa" . "https://melpa.org/packages/")
                         ("org" . "https://orgmode.org/elpa/")
                         ("elpa" . "https://elpa.gnu.org/packages/")))

(package-initialize)
(unless package-archive-contents
  (package-refresh-contents))

;; --- NEW: Install use-package so the commands below actually work ---
(unless (package-installed-p 'use-package)
  (package-install 'use-package))
(require 'use-package)

;; ivy is really cool package it makes life easier 
;; Enable Ivy
(use-package ivy
  :ensure t
  :config
  (ivy-mode 1)
  ;; Wrap around the list when you reach the bottom
  (setq ivy-wrap t)
  ;; Show the number of matches
  (setq ivy-count-format "(%d/%d) "))

;; Enable Counsel to upgrade default Emacs commands
(use-package counsel
  :ensure t
  :config
  (counsel-mode 1))

;; Enable Swiper for a much better file search (Parentheses fixed)
(use-package swiper
  :ensure t
  :bind (("C-s" . swiper)))

;; which-key package a small pop up that helps with keybindings
(use-package which-key
  :ensure t
  :config
  (which-key-mode));; close the boot screen

(setq inhibit-startup-message t)

(scroll-bar-mode -1) ;; Disable scroll bar
(tool-bar-mode -1)   ;; Disable tool bar
(tooltip-mode -1)    ;; Disable tooltips
(set-fringe-mode 10) ;; Give more room

(menu-bar-mode -1)   ;; disable menu bar

;; Set up visible bell

(setq visible-bell t)

;; Set Font and Font size, i wil not use this now

